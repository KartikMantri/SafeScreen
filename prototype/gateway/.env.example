# Copy to gateway/.env and fill in.

# anthropic | openai_compat | mock
VLM_PROVIDER=mock
VLM_MODEL=claude-opus-5
# low | medium | high  (Claude effort; low keeps each planning step fast)
VLM_EFFORT=low
ANTHROPIC_API_KEY=

# Later: Qwen2.5-VL on your own GPU server (vLLM) or any OpenAI-compatible host
# VLM_PROVIDER=openai_compat
# VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# OPENAI_COMPAT_BASE_URL=http://localhost:8001/v1
# OPENAI_COMPAT_API_KEY=EMPTY

# Installation keys the extension may use (comma separated)
SAFESCREEN_API_KEYS=isro-demo-key
